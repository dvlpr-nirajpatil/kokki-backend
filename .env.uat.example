PORT=3000

APP_NAME=Kokki
LOG_LEVEL=info

CLIENT_URL=https://uat.kokki.in

DATABASE_URL=postgresql://user:password@host:5432/kokki_uat
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379

AMAZON_AWS_ACCESS_KEY=your_aws_access_key
AWS_ACCESS_KEY_SECRET=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_uat_s3_bucket_name
AWS_CLOUDFRONT_DISTRIBUTION_ID=your_uat_cloudfront_distribution_id
CDN_BASE_URL=https://uat-cdn.kokki.in

UPLOAD_MAX_FILE_SIZE_MB=15
