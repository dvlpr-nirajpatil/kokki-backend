PORT=3000

APP_NAME=Kokki
LOG_LEVEL=info

CLIENT_URL=https://kokki.in

DATABASE_URL=postgresql://user:password@host:5432/kokki_production?sslmode=require
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379

API_SETU_CLIENT_ID = in.kokki
VERIFY_GST_API_KEY = 40a18338ec09f9be56a010e4405631ac7ebb16d0767dff7064b52b1861b51d81

# Uncomment both credentials when the deployed workload does not use an AWS role.
AMAZON_AWS_ACCESS_KEY=your_aws_access_key
AWS_ACCESS_KEY_SECRET=your_aws_secret_access_key

AWS_REGION=ap-south-1
AWS_BUCKET_NAME=kokki-production-storage
AWS_CLOUDFRONT_DISTRIBUTION_ID=E20A89QQJHZAWN
CDN_BASE_URL=https://assets.kokki.in

UPLOAD_MAX_FILE_SIZE_MB=15
